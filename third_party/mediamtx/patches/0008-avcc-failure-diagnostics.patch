+package gortmplib
+
+import (
+	"encoding/binary"
+	"fmt"
+	"time"
+)
+
+// avccDiagnosticError reports framing only, never compressed media or credentials.
+// Limit the walk even for adversarial input; this runs only after decoding failed.
+func avccDiagnosticError(cause error, payload []byte, dts time.Duration, messageType string) error {
+	offset := 0
+	units := 0
+	for units < 64 {
+		remaining := len(payload) - offset
+		if remaining < 4 {
+			return fmt.Errorf("unable to decode AVCC: %w (message=%s dtsMs=%d payloadBytes=%d naluIndex=%d offset=%d prefixBytes=%d)",
+				cause, messageType, dts.Milliseconds(), len(payload), units, offset, remaining)
+		}
+		declared := uint64(binary.BigEndian.Uint32(payload[offset : offset+4]))
+		available := remaining - 4
+		if declared > uint64(available) {
+			return fmt.Errorf("unable to decode AVCC: %w (message=%s dtsMs=%d payloadBytes=%d naluIndex=%d offset=%d declaredBytes=%d availableBytes=%d)",
+				cause, messageType, dts.Milliseconds(), len(payload), units, offset, declared, available)
+		}
+		offset += 4 + int(declared)
+		units++
+		if offset == len(payload) {
+			break
+		}
+	}
+	return fmt.Errorf("unable to decode AVCC: %w (message=%s dtsMs=%d payloadBytes=%d inspectedUnits=%d inspectedBytes=%d)",
+		cause, messageType, dts.Milliseconds(), len(payload), units, offset)
+}
