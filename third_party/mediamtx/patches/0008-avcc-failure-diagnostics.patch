+package gortmplib
+
+import (
+	"errors"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestAVCCDiagnosticError(t *testing.T) {
+	cause := errors.New("invalid length")
+	cases := []struct {
+		name    string
+		payload []byte
+		want    string
+	}{
+		{"empty", nil, "offset=0 prefixBytes=0"},
+		{"short prefix", []byte{0, 0, 1}, "offset=0 prefixBytes=3"},
+		{"oversized length", []byte{255, 255, 255, 255, 1}, "declaredBytes=4294967295 availableBytes=1"},
+		{"trailing prefix", []byte{0, 0, 0, 1, 42, 0}, "naluIndex=1 offset=5 prefixBytes=1"},
+		{"second unit truncated", []byte{0, 0, 0, 1, 42, 0, 0, 0, 2, 43}, "naluIndex=1 offset=5 declaredBytes=2 availableBytes=1"},
+		{"bounded zero units", make([]byte, 400), "inspectedUnits=64 inspectedBytes=256"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			err := avccDiagnosticError(cause, tc.payload, 123*time.Millisecond, "Video")
+			if !errors.Is(err, cause) || !strings.Contains(err.Error(), tc.want) || !strings.Contains(err.Error(), "dtsMs=123") {
+				t.Fatalf("unexpected diagnostic: %v", err)
+			}
+		})
+	}
+}
