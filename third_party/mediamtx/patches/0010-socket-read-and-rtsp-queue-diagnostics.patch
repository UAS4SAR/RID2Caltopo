+
+// Read metrics are only accessed by the RTMP read goroutine.
+type timedRTMPConn struct {
+	net.Conn
+	readTime time.Duration
+	maxRead  time.Duration
+	reads    uint64
+	bytes    uint64
+}
+
+func (c *timedRTMPConn) Read(p []byte) (int, error) {
+	started := time.Now()
+	n, err := c.Conn.Read(p)
+	elapsed := time.Since(started)
+	c.readTime += elapsed
+	c.maxRead = max(c.maxRead, elapsed)
+	c.reads++
+	c.bytes += uint64(n)
+	return n, err
+}
 
