diff -ruN a/internal/r2cingress/diag.go b/internal/r2cingress/diag.go
--- a/internal/r2cingress/diag.go	1969-12-31 16:00:00
+++ b/internal/r2cingress/diag.go	2026-11-09 08:09:34
@@ -0,0 +1,33 @@
+// Package r2cingress shares reader diagnostics between the RTMP read loop,
+// the recorder, and the iOS log bridge. Counters are process-wide and atomic.
+package r2cingress
+
+import "sync/atomic"
+
+// LogOverflow is the number of MediaMTX log lines dropped by the iOS bridge
+// because the Swift callback fell behind. The Android process does not use
+// that bridge, so this stays zero there.
+var LogOverflow atomic.Uint64
+
+// driftActive is set while a recorder timestamp-drift reset is outstanding.
+var driftActive atomic.Bool
+
+// NoteLogOverflow records the cumulative number of dropped log lines.
+func NoteLogOverflow(dropped uint64) {
+	LogOverflow.Store(dropped)
+}
+
+// NoteDriftReset marks a recorder drift reset as in progress.
+func NoteDriftReset() {
+	driftActive.Store(true)
+}
+
+// ClearDriftReset marks the recorder as past the drift reset.
+func ClearDriftReset() {
+	driftActive.Store(false)
+}
+
+// DriftResetInProgress reports whether a drift reset has not finished.
+func DriftResetInProgress() bool {
+	return driftActive.Load()
+}
