diff -ruN a/internal/protocols/rtmp/publish_handoff.go b/internal/protocols/rtmp/publish_handoff.go
--- a/internal/protocols/rtmp/publish_handoff.go	1969-12-31 16:00:00
+++ b/internal/protocols/rtmp/publish_handoff.go	2026-11-09 08:09:34
@@ -0,0 +1,215 @@
+package rtmp
+
+import (
+	"sync"
+
+	"github.com/bluenviron/gortsplib/v5/pkg/description"
+	"github.com/bluenviron/gortsplib/v5/pkg/format"
+	"github.com/bluenviron/mediamtx/internal/unit"
+)
+
+// PublishHandoffCapacity is the number of demuxed units the reader may queue
+// before it drops to the next keyframe. The reader never waits for this queue.
+const PublishHandoffCapacity = 96
+
+// PublishHandoff moves demuxed units off the RTMP read goroutine.
+// Submit copies the payload and returns immediately. Run performs stream
+// forwarding, recording, and RTSP fan-out on a different goroutine.
+type PublishHandoff struct {
+	capacity int
+
+	mu       sync.Mutex
+	cond     *sync.Cond
+	queue    []queuedUnit
+	head     int
+	count    int
+	closed   bool
+	dropping bool
+	drops    uint64
+}
+
+type queuedUnit struct {
+	media    *description.Media
+	format   format.Format
+	unit     *unit.Unit
+	keyframe bool
+}
+
+// NewPublishHandoff returns a handoff with a fixed capacity.
+func NewPublishHandoff(capacity int) *PublishHandoff {
+	if capacity < 1 {
+		capacity = 1
+	}
+	h := &PublishHandoff{
+		capacity: capacity,
+		queue:    make([]queuedUnit, capacity),
+	}
+	h.cond = sync.NewCond(&h.mu)
+	return h
+}
+
+// Submit queues one unit without blocking. When the queue is full, units are
+// dropped until the next video keyframe so a decoder is not left mid-GOP.
+func (h *PublishHandoff) Submit(
+	media *description.Media,
+	forma format.Format,
+	u *unit.Unit,
+) {
+	if u == nil {
+		return
+	}
+	cloned := cloneUnit(u)
+	keyframe := unitIsKeyframe(cloned)
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.closed {
+		h.drops++
+		return
+	}
+	if h.dropping && !keyframe {
+		h.drops++
+		return
+	}
+	if h.count >= h.capacity {
+		h.dropping = true
+		h.drops++
+		return
+	}
+	if keyframe {
+		h.dropping = false
+	}
+	index := (h.head + h.count) % h.capacity
+	h.queue[index] = queuedUnit{media: media, format: forma, unit: cloned, keyframe: keyframe}
+	h.count++
+	h.cond.Signal()
+}
+
+// Depth returns the number of units waiting for the downstream goroutine.
+func (h *PublishHandoff) Depth() int {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	return h.count
+}
+
+// Drops returns how many units were discarded instead of queued.
+func (h *PublishHandoff) Drops() uint64 {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	return h.drops
+}
+
+// Run calls write for each queued unit until Close.
+func (h *PublishHandoff) Run(write func(media *description.Media, forma format.Format, u *unit.Unit)) {
+	for {
+		h.mu.Lock()
+		for h.count == 0 && !h.closed {
+			h.cond.Wait()
+		}
+		if h.count == 0 && h.closed {
+			h.mu.Unlock()
+			return
+		}
+		item := h.queue[h.head]
+		h.queue[h.head] = queuedUnit{}
+		h.head = (h.head + 1) % h.capacity
+		h.count--
+		h.mu.Unlock()
+		write(item.media, item.format, item.unit)
+	}
+}
+
+// Close unblocks Run after the queued units have been delivered.
+func (h *PublishHandoff) Close() {
+	h.mu.Lock()
+	h.closed = true
+	h.mu.Unlock()
+	h.cond.Broadcast()
+}
+
+func unitIsKeyframe(u *unit.Unit) bool {
+	switch payload := u.Payload.(type) {
+	case unit.PayloadH264:
+		return h264AccessUnitIsKeyframe(payload)
+	case unit.PayloadH265:
+		return h265AccessUnitIsKeyframe(payload)
+	default:
+		// Audio and other payloads are not a video GOP boundary.
+		return false
+	}
+}
+
+func h264AccessUnitIsKeyframe(au [][]byte) bool {
+	for _, nal := range au {
+		if len(nal) > 0 && nal[0]&0x1F == 5 {
+			return true
+		}
+	}
+	return false
+}
+
+func h265AccessUnitIsKeyframe(au [][]byte) bool {
+	for _, nal := range au {
+		if len(nal) == 0 {
+			continue
+		}
+		nalType := (nal[0] >> 1) & 0x3F
+		// BLA, IDR, and CRA pictures.
+		if nalType >= 16 && nalType <= 21 {
+			return true
+		}
+	}
+	return false
+}
+
+func cloneUnit(u *unit.Unit) *unit.Unit {
+	cloned := *u
+	cloned.Payload = clonePayload(u.Payload)
+	return &cloned
+}
+
+func clonePayload(payload unit.Payload) unit.Payload {
+	switch value := payload.(type) {
+	case unit.PayloadH264:
+		return unit.PayloadH264(cloneNALUnits(value))
+	case unit.PayloadH265:
+		return unit.PayloadH265(cloneNALUnits(value))
+	case unit.PayloadAV1:
+		return unit.PayloadAV1(cloneNALUnits(value))
+	case unit.PayloadAC3:
+		return unit.PayloadAC3(cloneNALUnits(value))
+	case unit.PayloadMPEG1Audio:
+		return unit.PayloadMPEG1Audio(cloneNALUnits(value))
+	case unit.PayloadMPEG4Audio:
+		return unit.PayloadMPEG4Audio(cloneNALUnits(value))
+	case unit.PayloadOpus:
+		return unit.PayloadOpus(cloneNALUnits(value))
+	case unit.PayloadG711:
+		return unit.PayloadG711(append([]byte(nil), value...))
+	case unit.PayloadKLV:
+		return unit.PayloadKLV(append([]byte(nil), value...))
+	case unit.PayloadLPCM:
+		return unit.PayloadLPCM(append([]byte(nil), value...))
+	case unit.PayloadMJPEG:
+		return unit.PayloadMJPEG(append([]byte(nil), value...))
+	case unit.PayloadMPEG1Video:
+		return unit.PayloadMPEG1Video(append([]byte(nil), value...))
+	case unit.PayloadMPEG4AudioLATM:
+		return unit.PayloadMPEG4AudioLATM(append([]byte(nil), value...))
+	case unit.PayloadMPEG4Video:
+		return unit.PayloadMPEG4Video(append([]byte(nil), value...))
+	case unit.PayloadVP8:
+		return unit.PayloadVP8(append([]byte(nil), value...))
+	case unit.PayloadVP9:
+		return unit.PayloadVP9(append([]byte(nil), value...))
+	default:
+		return payload
+	}
+}
+
+func cloneNALUnits(units [][]byte) [][]byte {
+	cloned := make([][]byte, len(units))
+	for i, nal := range units {
+		cloned[i] = append([]byte(nil), nal...)
+	}
+	return cloned
+}
