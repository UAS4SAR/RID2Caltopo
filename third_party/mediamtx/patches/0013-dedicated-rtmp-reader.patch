--- a/internal/servers/rtmp/socket_pending_unix.go	1969-12-31 16:00:00
+++ b/internal/servers/rtmp/socket_pending_unix.go	2026-11-09 08:09:34
@@ -0,0 +1,34 @@
+//go:build darwin || linux
+
+package rtmp
+
+import (
+	"net"
+	"syscall"
+	"unsafe"
+)
+
+func socketPendingBytes(conn net.Conn) int {
+	sysConn, ok := conn.(syscall.Conn)
+	if !ok {
+		return -1
+	}
+	raw, err := sysConn.SyscallConn()
+	if err != nil {
+		return -1
+	}
+	pending := -1
+	_ = raw.Control(func(fd uintptr) {
+		var waiting int
+		_, _, errno := syscall.Syscall(
+			syscall.SYS_IOCTL,
+			fd,
+			uintptr(fionreadRequest),
+			uintptr(unsafe.Pointer(&waiting)),
+		)
+		if errno == 0 {
+			pending = waiting
+		}
+	})
+	return pending
+}
