+
+func TestServerPublishContinuesWhileDownstreamIsSlow(t *testing.T) {
+	pathManager := &test.PathManager{
+		FindPathConfImpl: func(req defs.PathFindPathConfReq) (*conf.Path, error) {
+			return &conf.Path{RTMPPublishVideoOnly: true}, nil
+		},
+		AddPublisherImpl: func(req defs.PathAddPublisherReq) (defs.Path, *stream.SubStream, error) {
+			strm := &stream.Stream{
+				Desc:              req.Desc,
+				WriteQueueSize:    512,
+				RTPMaxPayloadSize: 1450,
+				Parent:            test.NilLogger,
+			}
+			require.NoError(t, strm.Initialize())
+			subStream := &stream.SubStream{Stream: strm, UseRTPPackets: false}
+			require.NoError(t, subStream.Initialize())
+
+			reader := &stream.Reader{Parent: test.NilLogger}
+			reader.OnData(strm.Desc.Medias[0], strm.Desc.Medias[0].Formats[0], func(u *unit.Unit) error {
+				time.Sleep(40 * time.Millisecond)
+				return nil
+			})
+			strm.AddReader(reader)
+			return &dummyPath{}, subStream, nil
+		},
+	}
+
+	server := &Server{
+		Address:         "127.0.0.1:1945",
+		ReadTimeout:     conf.Duration(10 * time.Second),
+		WriteTimeout:    conf.Duration(10 * time.Second),
+		ExternalCmdPool: &externalcmd.Pool{},
+		PathManager:     pathManager,
+		Parent:          test.NilLogger,
+	}
+	require.NoError(t, server.Initialize())
+	defer server.Close()
+
+	target, err := url.Parse("rtmp://127.0.0.1:1945/slow")
+	require.NoError(t, err)
+	conn := &gortmplib.Client{URL: target, Publish: true}
+	require.NoError(t, conn.Initialize(context.Background()))
+	defer conn.Close()
+
+	writer := &gortmplib.Writer{
+		Conn: conn,
+		Tracks: []*gortmplib.Track{{
+			Codec: &codecs.H264{SPS: test.FormatH264.SPS, PPS: test.FormatH264.PPS},
+		}},
+	}
+	require.NoError(t, writer.Initialize())
+
+	payload := make([]byte, 64*1024)
+	payload[0] = 5
+	finished := make(chan error, 1)
+	go func() {
+		for i := 0; i < 24; i++ {
+			payload[1] = byte(i)
+			writeErr := writer.WriteH264(
+				writer.Tracks[0],
+				time.Duration(i)*time.Millisecond,
+				time.Duration(i)*time.Millisecond,
+				[][]byte{payload},
+			)
+			if writeErr != nil {
+				finished <- writeErr
+				return
+			}
+		}
+		finished <- nil
+	}()
+
+	select {
+	case err = <-finished:
+		require.NoError(t, err)
+	case <-time.After(2 * time.Second):
+		t.Fatal("publisher blocked while downstream was slow")
+	}
+}
