--- a/internal/protocols/rtmp/publish_handoff_test.go	1969-12-31 16:00:00
+++ b/internal/protocols/rtmp/publish_handoff_test.go	2026-11-09 08:09:34
@@ -0,0 +1,122 @@
+package rtmp
+
+import (
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/bluenviron/gortsplib/v5/pkg/description"
+	"github.com/bluenviron/gortsplib/v5/pkg/format"
+	"github.com/bluenviron/mediamtx/internal/unit"
+	"github.com/stretchr/testify/require"
+)
+
+func h264Unit(keyframe bool, marker byte) *unit.Unit {
+	nalType := byte(1)
+	if keyframe {
+		nalType = 5
+	}
+	return &unit.Unit{
+		PTS:     1,
+		Payload: unit.PayloadH264{[]byte{nalType, marker}},
+	}
+}
+
+func TestPublishHandoffDoesNotBlockWhenDownstreamIsSlow(t *testing.T) {
+	handoff := NewPublishHandoff(4)
+	started := make(chan struct{})
+	var once sync.Once
+	release := make(chan struct{})
+	go handoff.Run(func(_ *description.Media, _ format.Format, _ *unit.Unit) {
+		once.Do(func() { close(started) })
+		<-release
+	})
+
+	handoff.Submit(nil, nil, h264Unit(true, 1))
+	select {
+	case <-started:
+	case <-time.After(time.Second):
+		t.Fatal("downstream did not start")
+	}
+
+	began := time.Now()
+	for i := 0; i < 200; i++ {
+		handoff.Submit(nil, nil, h264Unit(i%20 == 0, byte(i)))
+	}
+	elapsed := time.Since(began)
+	require.Less(t, elapsed, 200*time.Millisecond)
+	require.Greater(t, handoff.Drops(), uint64(0))
+
+	close(release)
+	handoff.Close()
+}
+
+func TestPublishHandoffDropsUntilNextKeyframe(t *testing.T) {
+	handoff := NewPublishHandoff(1)
+	var mu sync.Mutex
+	var received []byte
+	started := make(chan struct{})
+	var once sync.Once
+	hold := make(chan struct{})
+	go handoff.Run(func(_ *description.Media, _ format.Format, u *unit.Unit) {
+		payload := u.Payload.(unit.PayloadH264)
+		mu.Lock()
+		received = append(received, payload[0][1])
+		mu.Unlock()
+		once.Do(func() { close(started) })
+		if payload[0][1] == 1 {
+			<-hold
+		}
+	})
+
+	handoff.Submit(nil, nil, h264Unit(true, 1))
+	<-started
+	handoff.Submit(nil, nil, h264Unit(false, 2))
+	handoff.Submit(nil, nil, h264Unit(false, 3))
+	handoff.Submit(nil, nil, h264Unit(true, 4))
+	require.GreaterOrEqual(t, handoff.Drops(), uint64(2))
+	close(hold)
+	require.Eventually(t, func() bool { return handoff.Depth() == 0 }, time.Second, 10*time.Millisecond)
+
+	handoff.Submit(nil, nil, h264Unit(false, 6))
+	handoff.Submit(nil, nil, h264Unit(true, 5))
+	require.Eventually(t, func() bool {
+		mu.Lock()
+		defer mu.Unlock()
+		for _, marker := range received {
+			if marker == 5 {
+				return true
+			}
+		}
+		return false
+	}, time.Second, 10*time.Millisecond)
+	mu.Lock()
+	for _, marker := range received {
+		require.NotEqual(t, byte(3), marker)
+		require.NotEqual(t, byte(4), marker)
+		require.NotEqual(t, byte(6), marker)
+	}
+	mu.Unlock()
+	handoff.Close()
+}
+
+func TestPublishHandoffCopiesPayloadBeforeReuse(t *testing.T) {
+	handoff := NewPublishHandoff(2)
+	got := make(chan []byte, 1)
+	go handoff.Run(func(_ *description.Media, _ format.Format, u *unit.Unit) {
+		payload := u.Payload.(unit.PayloadH264)
+		got <- append([]byte(nil), payload[0]...)
+	})
+
+	source := []byte{5, 9, 9}
+	handoff.Submit(nil, nil, &unit.Unit{Payload: unit.PayloadH264{source}})
+	source[1] = 1
+
+	select {
+	case copied := <-got:
+		require.Equal(t, []byte{5, 9, 9}, copied)
+	case <-time.After(time.Second):
+		t.Fatal("unit was not delivered")
+	}
+	handoff.Close()
+}
